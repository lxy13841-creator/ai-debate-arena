# 网页中的“API 密钥”设置会自动创建 .env；也可以手动复制本文件。
# 只需填写实际使用的服务。请勿把真实密钥提交到 Git。
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# 可选：覆盖默认接口和模型。网页可直接选择 Kimi K2.6 / K3 和 DeepSeek V4 Pro / Flash。
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=kimi-k2.6
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro

# 每名选手每次发言的统一限制；所有轮次都使用同一组配置。
AI_DEBATE_MAX_CHARS=600
AI_DEBATE_MAX_TOKENS=1600
# 立场生成 Agent 的结构化观点输出 token 上限。
AI_DEBATE_VIEWPOINT_MAX_TOKENS=400
# 总结 Agent 每轮结构化图谱输出的 token 上限。
AI_DEBATE_SUMMARY_MAX_TOKENS=2400
AI_DEBATE_REQUEST_TIMEOUT=90
AI_DEBATE_TURN_PAUSE=1
